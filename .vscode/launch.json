{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "main.py scrape",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {"PYDEVD_WARN_SLOW_RESOLVE_TIMEOUT": "2"},
            "args": [
                "scrape",
                /*"-b",*/
                "https://www.mountaineers.org/members/will-wade"
                /* "--profile", "https://www.mountaineers.org/members/colin-farrell" */
            ]
        },
        {
            "name": "main.py scrapedue",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "scrapedue", 
                "-d", "1",
                "--limit", "3"
            ]
        },
        {
            "name": "main.py whowith",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "whowith", "tkunger", "2025-10-19"
            ]
        },
        {
            "name": "main.py diddo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "diddo", 
                "--person", "alan marshall",
                "Flattery", 
            ]
        },
        {
            "name": "main.py history",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "history", 
                "michelle farrel", 
            ]
        },
        {
            "name": "main.py tripstatus",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "tripstatus", "tom unger", "2025-04-06", "--update", "-b"
            ]
        },
        {
            "name": "main.py dido",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "-C", "local-config.txt",
                "diddo", "deception pass",
                "--profile", "https://www.mountaineers.org/members/colin-farrell" 
            ]
        },
        {
            "name": "main.py activity",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "-C", "local-config.txt",
                "-S",
                "-u", "tkunger",
                "activity", "Sea Kayaking"
            ]
        }

    ]
}